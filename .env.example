TELEGRAM_BOT_TOKEN=123456:replace-with-your-token
DATABASE_PATH=/data/singularity.db
BOT_ADMIN_USER_IDS=
BOT_RSS_POLL_INTERVAL=5m
BOT_POLL_TIMEOUT_SECONDS=50
BOT_WELCOME_MESSAGE=欢迎 %s 入群。
BOT_VERIFICATION_ENABLED=true
BOT_VERIFICATION_TIMEOUT=3m
BOT_VERIFICATION_MAX_VALUE=20
BOT_VERIFICATION_KICK_ON_TIMEOUT=true
BOT_AD_KEYWORDS=加微信,微信,加v,vx,代理,返佣,返利,推广,刷单,兼职,贷款,博彩,娱乐城,空投,稳赚,私聊,t.me/,telegram.me/
BOT_AD_SCORE_THRESHOLD=3
BOT_AD_LINK_LIMIT=2
BOT_BAN_ADVERTISERS=true
BOT_RSS_MAX_ITEMS_PER_POLL=5
